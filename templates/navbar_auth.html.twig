                    <span class="navbar-brand fs-4 ff-serif ms-0 ms-2 text-bg-primary">boîte à partage<span class="ms-2 text-highlight">●</span></span>
                </a>
            </h1>
            <button type="button" class="btn-close" data-bs-theme="dark" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body px-0">
        <div class="px-2 ">
            <div class="d-grid gap-2 ">
                <a class="ps-2 link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 text-start" href="{{ path('app_item_create') }}"><i class="bi bi-plus-square me-2"></i>Proposer un nouvel objet</a>
