            <div class="d-grid gap-2 ">
                <a class="ps-2 link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 text-start" href="{{ path('app_user_profile') }}"><i class="bi bi-person-circle me-2"></i>Mon compte</a>
            </div>
        </div>
