                        <form class="row row-cols-lg-auto g-3 align-items-center ms-1" id="usurpateForm" method="GET" action="{{path('app_auth_home')}}">
                            <div class="col-4 d-none">
                                <label class="visually-hidden" for="inlineFormInputGroupUsername">Username</label>
                                <input name="usurpateEmailInput" type="text" class="form-control" id="inlineFormInputGroupUsername" placeholder="Username">
                            </div>
                            <div class="col-10">
                                <label class="visually-hidden" for="inlineFormSelectPref">User</label>
                                <select name="usurpateEmailSelect" class="form-select form-select-sm">
                                    <option value="corentoulf@hotmail.com" selected>corentoulf@hotmail.com</option>
                                    <option value="corentoulf@yopmail.com" selected>corentoulf@yopmail.com</option>
                                </select>
                            </div>
                            <div class="col-2">
                                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-arrow-right"></i></button>
                            </div>
                        </form>
                    </div>
                {% endif %}
                {% if is_granted('IS_IMPERSONATOR') %}
                    <div class="d-grid gap-2 ">
                        <a class="ps-2 link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 text-start" href="{{ impersonation_exit_path(path('app_auth_home')) }}"><i class="bi bi-person-x me-2"></i>Exit impersonation</a>
                    </div>
                {% endif %}
            </div>
        {% endif %}
