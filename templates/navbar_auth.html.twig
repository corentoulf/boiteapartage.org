            </div>
        </div>
        {# section separator #}
        <hr class="border border-1 opacity-100">
        {# Section prets/emprunts actions #}
        <div class="px-2">
            <div class="d-grid gap-2 ">
                <a class="ps-2 link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 text-start" href="{{ path('app_list_incoming_loan') }}"><i class="bi bi-arrow-down-left me-2"></i>Emprunts</a>
                <a class="ps-2 link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 text-start" href="{{ path('app_list_outgoing_loan') }}"><i class="bi bi-arrow-up-right me-2"></i>Prêts</a>
            </div>
        </div>
        {# section separator #}
        <hr class="border border-1 opacity-100">
        {# Section primary actions #}
        <div class="px-2">
            <div class="d-grid gap-2 ">
                <a class="ps-2 link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 text-start" href="{{ path('app_circle') }}"><i class="bi bi-archive me-2"></i>Mes Boîtes</a>
                <a class="ps-2 link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 text-start" href="{{ path('app_circle_create') }}"><i class="bi bi-plus-square me-2"></i>Créer une boîte</a>
                <a class="ps-2 link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 text-start" href="{{ path('app_circle_join') }}"><i class="bi bi-arrow-right-square me-2"></i>Rejoindre une boîte</a>
            </div>
        </div>
        {# section separator #}
        <hr class="border border-1 opacity-100">
        {# Section others #}
        <div class="px-2">
            <div class="d-grid gap-2 ">
                <a class="ps-2 link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 text-start" href=""><i class="bi bi-question-circle me-2"></i>Comment ça marche ?</a>
                <a class="ps-2 link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 text-start" href=""><i class="bi bi-chat-left-quote me-2"></i>Questions fréquentes</a>
            </div>
        </div>
