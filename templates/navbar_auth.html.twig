<!-- Modal -->
<div class="modal " id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content">
      <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">
                <a class="navbar-brand d-flex align-items-center " href="{{path('app_auth_home')}}">
                    <img class="" src="{{asset('img/logo-bleu-petard.svg')}}" alt="La Boîte à Partage" width="35" height="35">
                    <span class="navbar-brand fw-bold ms-0 ms-2">Boîte à Partage</span>
                </a>
            </h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body px-0">
        {# Section primary actions #}
        <div class="px-2">
            <div class="d-grid gap-2 ">
                <a class="btn btn-outline-highlight-subtle text-start" href="{{ path('app_item_create') }}"><i class="bi bi-plus-circle me-2"></i>Proposer un objet</a>
            </div>
            <div class="d-grid gap-2 ">
                <a class="btn btn-outline-highlight-subtle text-start" href="{{ path('app_circle_join') }}"><i class="bi bi-arrow-right-square me-2"></i>Rejoindre une boîte</a>
            </div>
            <div class="d-grid gap-2 ">
                <a class="btn btn-outline-highlight-subtle text-start" href="{{ path('app_circle_create') }}"><i class="bi bi-plus-square me-2"></i>Créer une boîte</a>
            </div>
        </div>
        {# section separator #}
        <hr class="border border-1 opacity-100">
        {# Section modules #}
        <div class="px-2">
            <div class="d-grid gap-2 ">
                <a class="btn btn-outline-highlight-subtle text-start" href="{{ path('app_circle') }}"><i class="bi bi-archive me-2"></i>Boîtes</a>
            </div>
            <div class="d-grid gap-2 ">
                <a class="btn btn-outline-highlight-subtle text-start" href="{{ path('app_items') }}"><i class="bi bi-bookshelf me-2"></i>Placard</a>
            </div>
            <div class="d-grid gap-2 ">
                <a class="btn btn-outline-highlight-subtle text-start" href="{{ path('app_user_profile') }}"><i class="bi bi-person-circle me-2"></i>Compte</a>
            </div>
        </div>
        {# section separator #}
        <hr class="border border-1 opacity-100">
        {# Section others #}
        <div class="px-2">
            <div class="d-grid gap-2 ">
                <a class="btn btn-outline-highlight-subtle text-start" href=""><i class="bi bi-question-circle me-2"></i>Comment ça marche ?</a>
            </div>
            <div class="d-grid gap-2 ">
                <a class="btn btn-outline-highlight-subtle text-start" href=""><i class="bi bi-chat-left-quote me-2"></i>Questions fréquentes</a>
            </div>
        </div>
        {# section separator #}
        <hr class="border border-1 border-dark opacity-50">
        {# deconnexion #}
        {% if app.user %}
            <div class="px-2">
                <div class="d-grid gap-2 ">
                    <a class="btn btn-outline-highlight-subtle text-start" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a>
                </div>
            </div>
        {% endif %}
        {# ADMIN #}
        {% if is_granted("ROLE_ADMIN") %}
            <hr class="border border-1 opacity-100">
            <div class="px-2">
                <div class="d-grid gap-2 ">
                    <a class="btn btn-outline-highlight-subtle text-start" href="{{ path('app_admin') }}"><i class="bi bi-database-fill-gear me-2"></i>Admin</a>
                </div>
                {% if is_granted("ROLE_ALLOWED_TO_SWITCH") %}
                    <div class="d-grid gap-2 ">
                        <form class="row row-cols-lg-auto g-3 align-items-center ms-1" id="usurpateForm" method="GET" action="{{path('app_auth_home')}}">
                            <div class="col-4 d-none">
                                <label class="visually-hidden" for="inlineFormInputGroupUsername">Username</label>
                                <input name="usurpateEmailInput" type="text" class="form-control" id="inlineFormInputGroupUsername" placeholder="Username">
                            </div>
                            <div class="col-10">
                                <label class="visually-hidden" for="inlineFormSelectPref">User</label>
                                <select name="usurpateEmailSelect" class="form-select">
                                    <option value="corentoulf@hotmail.com" selected>corentoulf@hotmail.com</option>
                                    <option value="corentoulf@yopmail.com" selected>corentoulf@yopmail.com</option>
                                </select>
                            </div>
                            <div class="col-2">
                                <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-right"></i></button>
                            </div>
                        </form>
                    </div>
                {% endif %}
                {% if is_granted('IS_IMPERSONATOR') %}
                    <div class="d-grid gap-2 ">
                        <a class="btn btn-outline-highlight-subtle text-start" href="{{ impersonation_exit_path(path('app_auth_home')) }}"><i class="bi bi-person-x me-2"></i>Exit impersonation</a>
                    </div>
                {% endif %}
            </div>
        {% endif %}
        {% if is_granted('IS_IMPERSONATOR') and not is_granted("ROLE_ADMIN")%}
            <hr class="border border-1 opacity-100">
            <div class="px-2">
                <div class="d-grid gap-2 ">
                    <a class="btn btn-outline-highlight-subtle text-start" href="{{ impersonation_exit_path(path('app_auth_home')) }}"><i class="bi bi-person-x me-2"></i>Exit impersonation</a>
                </div>
            </div>
        {% endif %}
