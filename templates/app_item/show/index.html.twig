{% extends 'base_auth.html.twig' %}

{% block title %}Mon Placard{% endblock %}
{% set defaultImgUrl= asset('img/no-cover-picture-alt.svg') %}
{% set allowClickOnItem = false %}
{% set cardHighlightedWithShadow = true %}
{% block body %}
<div class="container min-vh-100">
  <div class="col-md-8 offset-md-2 px-2 py-3 p-lg-5">
  {%  set referer = app.request.server.get('HTTP_REFERER')|default('/') %}
    {{ include('_component/_header_title.html.twig', {targetLabel: "Retour", targetPath:referer, pageTitle:"Emprunter "~ item.property1}) }}
    <div class="card bg-cream border-0 p-2 mt-4">
      <div class="card-body">
        <h6 class="text-uppercase text-secondary-emphasis mb-3">Faire une demande d'emprunt</h6>
        {{ include('_component/item_card.html.twig') }}
        <div class="row py-4">
          {{ form_errors(form) }}
          {{ form_start(form) }}
          {{ form_end(form) }}
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'itemIndex']) }}
    {% endblock %}
{% endblock %}