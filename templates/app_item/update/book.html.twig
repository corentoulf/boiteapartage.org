{% extends 'base_auth.html.twig' %}

{% block title %}Ajout au Placard{% endblock %}

{% block body %}

<div class="container min-vh-100">
    <div class="col-md-8 offset-md-2 px-2 py-3 p-lg-5">
        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}
        <div class="align-items-center d-flex flex-row justify-content-between">
            <h1 class="fw-bold fs-3" id="title">Mettre à jour un livre</span></h1>
        </div>

        {# step 2 : ajout manuel ou pré-remplissage depuis scan #}
        <div id="bookFormContainer" class="">
            <div class="mt-3">
                <a id="restartCompleteForm" style="display:none;" href="#" data-bs-dismiss="modal" class="link-dark link-offset-2 link-opacity-75 link-underline-opacity-25 link-underline-opacity-75-hover"><i class="me-2 bi bi-arrow-left"></i>Recommencer</a>
            </div>
            <div class="mt-2" id="bookForm">
                {{ form_errors(form) }}
                {{ form_start(form) }}
                
                {{ form_row(form.itemType)}}
                {{ form_row(form.property_1)}}
                {{ form_row(form.property_2)}}
                {{ form_row(form.property_3)}}
                {{ form_row(form.property_4)}}     
                {{ form_row(form.imageFile)}}
                <div id="imageCoverContainer" class="">
                    <div 
                        id="photoCaptureTip"
                        class="form-text mb-2 help-text" 
                        {% if item.property3 or item.imageName %}
                            style="display:none;"
                        {% endif %}
                    >
                        Conseil : posez le livre sur une table pour prendre la couverture dans son intégralité.
                    </div>
                    <a 
                        href="#" id="openFileInputBtn" 
                        class="btn btn-dark"
                        {% if item.property3 or item.imageName %}
                            style="display:none;"
                        {% endif %}
                    >
                        <i class="bi bi-camera-fill me-2"></i>Ajouter une photo
                    </a>
                    <div class="d-flex flex-column align-items-start mb-3">
                        <div class="col-8 col-md-4">
                            <img 
                                id="imgBookCover" 
                                class="img-fluid" 
                                {% if item.property3 or item.imageName %}
                                    {% if item.property3 %}
                                        src="{{item.property3}}"  
                                    {% else %}
                                        src="{{vich_uploader_asset(item, 'imageFile')}}"  
                                    {% endif %}
                                {% else %}
                                    style="display:none;"
                                {% endif %}
                            />
                        </div>
                        <div 
                            id="retakePhotoBtn" 
                            class="mt-2"
                            {% if item.imageName %}
                            {% else %}
                                style="display:none;"
                            {% endif %}
                        >
                            <a href="#" class="link-dark link-offset-2 link-opacity-75 link-underline-opacity-25 link-underline-opacity-75-hover" >
                                <i class="me-2 bi bi-arrow-counterclockwise"></i>Remplacer la photo
                            </a>
                        </div>
                    </div>
                </div>
                <div class="row mt-5">
                    <div class="col d-flex justify-content-end">
                        {{ form_row(form.submitAndAdd) }}
                        <div class="ms-2">
                            {{ form_row(form.submit) }}
                        </div>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>



<!-- Modal SCAN -->
<div class="modal" id="barcodeScannerModal" tabindex="-1" aria-labelledby="barcodeScannerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="barcodeScannerModalLabel">Visez le code-barre du livre</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        {# reader part for scaning #}
        <div id="reader" width="600px" height="600px">
        </div>
        {# result found part #}
        <div id="scanResultContainer" class="">
        </div>
        {# no result found #}
        <div id="scanNoResultContainer">
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'itemAddBook']) }}
    {% endblock %}
{% endblock %}