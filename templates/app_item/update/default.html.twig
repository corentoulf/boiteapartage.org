{% extends 'base_auth.html.twig' %}

{% block title %}Modifier un objet{% endblock %}

{% block body %}

<div class="container min-vh-100">
    <div class="col-md-8 offset-md-2 px-2 py-3 p-lg-5">
        {{ include('_component/_header_title.html.twig', {targetLabel: "Mon placard", targetPath:path(name = 'app_items_mine'), pageTitle:'Modifier un objet'}) }}
        <div class="card bg-cream border-0 p-4 mt-4">
            <div id="" class="fw-bold fs-5 mb-4">Modifiez les éléments souhaités</div>
            {{ form_errors(form) }}
            {{ form_start(form) }}
            {{ form_row(form.itemType)}}
            {{ form_row(form.property_1)}}
            {{ form_row(form.property_2)}}
            {{ form_row(form.imageFile)}}
            <div id="imageCoverContainer" class="">
                <a 
                    href="#" 
                    id="openFileInputBtn" 
                    class="btn btn-dark" 
                    {% if item.imageName %}
                        style="display:none;"
                    {% endif %}
                >
                    <i class="bi bi-camera-fill me-2"></i>Ajouter une photo
                </a>
                <div class="d-flex flex-column align-items-start">
                    <div class="col-8 col-md-4">
                        <img 
                            id="imgBookCover" 
                            class="img-fluid" 
                            {% if not item.imageName %}
                                style="display:none;"
                            {% else %}
                                src="{{vich_uploader_asset(item, 'imageFile')}}"     
                            {% endif %}
                        />
                    </div>
                    <div 
                        id="retakePhotoBtn"
                        class="mt-2"
                        {% if not item.imageName %}
                            style="display:none;"
                        {% endif %}
                    >
                        <a href="#" class="link-dark link-offset-2 link-opacity-75 link-underline-opacity-25 link-underline-opacity-75-hover"><i class="me-2 bi bi-arrow-counterclockwise"></i>Remplacer la photo</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col d-flex justify-content-end">
                <div class="ms-2">
                    {{ form_row(form.submit) }}
                </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
</div>


{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'itemAddDefault']) }}
    {% endblock %}
{% endblock %}