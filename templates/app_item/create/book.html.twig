{% extends 'base_auth.html.twig' %}

{% block title %}Ajout au Placard{% endblock %}

{% block body %}

<div class="container min-vh-100">
    <div class="col-md-8 offset-md-2 px-2 py-3 p-lg-5">
        {{ include('_component/_header_title.html.twig', {targetLabel: "Choix de la catégorie", targetPath:path(name = 'app_item_create'), pageTitle:"Ajouter à la bibliothèque"}) }}
        <div id="infoAndScanContainer">
            <div class="card bg-cream border-0 p-4 mt-4" >
                {# option 1 : scan ou recherche #}
                <div >
                    <div id="" class="fw-bold fs-5">Ajout rapide</div>
                    <div class="mt-2">
                        Pour ajouter un livre en un clic, <b>scannez le code-barres</b> du livre en cliquant sur le bouton ci-dessous.
                    </div>
                    <div class="d-grid mt-3">
                        <btn id="openScanner" data-bs-toggle="modal" data-bs-target="#barcodeScannerModal" class="btn btn-secondary text-center"><i class="bi bi-upc-scan me-2"></i>Scanner le code-barres</btn>
                    </div>
                </div>
            </div>
            <div class="row my-4 justify-content-center align-items-center">
                <div class="col ps-5"><hr></div>
                    ou
                <div class="col pe-5"><hr></div>
            </div>
        </div>
        <div class="card bg-cream border-0 p-4 mt-4">
            {# option 2 : ajout manuel ou pré-remplissage depuis scan #}
            <div id="bookFormContainer" class="">
                <div class="mb-3">
                    <a id="restartCompleteForm" style="display:none;" href="#" data-bs-dismiss="modal" class="link-dark link-offset-2 link-opacity-75 link-underline-opacity-25 link-underline-opacity-75-hover"><i class="me-2 bi bi-arrow-counterclockwise"></i>Recommencer</a>
                </div>
                <div id="bookFormTitle" class="fw-bold fs-5">Ajout manuel</div>
                <div class="mt-2" id="bookForm">
                    {{ form_errors(form) }}
                    {{ form_start(form) }}
                    
                    {{ form_row(form.itemType)}}
                    {{ form_row(form.property_1)}}
                    {{ form_row(form.property_2)}}
                    {{ form_row(form.property_3)}}
                    {{ form_row(form.property_4)}}     
                    {{ form_row(form.imageFile)}}
                    <div id="imageCoverContainer" class="">
                        <div id="photoCaptureTip" class="form-text mb-2 help-text">Conseil : posez le livre sur une table pour prendre la couverture dans son intégralité.</div>
                        <div class="d-grid">
                            <a href="#" id="openFileInputBtn" class="btn btn-secondary"><i class="bi bi-camera-fill me-2"></i>Ajouter une photo</a>
                        </div>
                        <div class="d-flex flex-column align-items-start">
                            <div class="col-8 col-md-4">
                                <img id="imgBookCover" class="img-fluid" style="display:none; height:150px;"/>
                            </div>
                            <div id="retakePhotoBtn" class="mt-2" style="display:none;">
                                <a href="#" class="link-dark link-offset-2 link-opacity-75 link-underline-opacity-25 link-underline-opacity-75-hover"><i class="me-2 bi bi-arrow-counterclockwise"></i>Remplacer la photo</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col d-flex justify-content-end">
                {{ form_row(form.submitAndAdd) }}
                <div class="ms-2">
                    {{ form_row(form.submit) }}
                </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
</div>



<!-- Modal SCAN -->
<div class="modal" id="barcodeScannerModal" tabindex="-1" aria-labelledby="barcodeScannerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen-md-down">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="barcodeScannerModalLabel">Visez le code-barre du livre</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        {# reader part for scaning #}
        <div id="reader" width="600px" height="600px">
        </div>
        {# result found part #}
        <div id="scanResultContainer" class="">
        </div>
        {# no result found #}
        <div id="scanNoResultContainer">
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'itemAddBook']) }}
    {% endblock %}
{% endblock %}