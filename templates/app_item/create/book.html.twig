{% extends 'base_auth.html.twig' %}

{% block title %}Ajout au Placard{% endblock %}

{% block body %}

<div class="container min-vh-100">
    <div class="col-md-8 offset-md-2 p-2 p-lg-5">
        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}
        <div class="align-items-center d-flex flex-row justify-content-between">
            <h1 class="fw-bold" id="title">{% if updateMode|default(false) %}Mettre à jour un livre{% else %}Ajouter à la <span class="text-highlight">bibliothèque</span></h1>
        </div>
        {% endif %}

        {# step 1 : scan ou recherche #}
        <div id="infoAndScanContainer">
            <div class="mt-3">
                Pour ajouter un livre en un clic, vous pouvez <b>scanner son code-barres</b>. Sinon, complétez le formulaire ci-dessous.
            </div>
            <div class="card card-btn-primary justify-content-center mt-3">
                <div class="card-body">
                    <h5 class="card-title text-center"><i class="bi bi-upc-scan fs-1"></i></h5>
                    <p class="card-text text-center m-0">Scanner le code-barres</p>
                    <a id="openScanner" data-bs-toggle="modal" data-bs-target="#barcodeScannerModal" href="#" class="stretched-link"></a>
                </div>
            </div>
            <div class="row mt-2 justify-content-center align-items-center">
                <div class="col"><hr></div>
                    ou
                <div class="col"><hr></div>
            </div>
        </div>

        {# step 2 : ajout manuel ou pré-remplissage depuis scan #}
        <div id="bookFormContainer" class="">
            <div class="mt-3">
                <a id="restartCompleteForm" style="display:none;" href="#" data-bs-dismiss="modal" class="link-dark link-underline link-offset-2 link-underline-opacity-25 link-underline-opacity-75-hover"><i class="me-2 bi bi-arrow-counterclockwise"></i>Recommencer</a>
            </div>
            <div id="bookFormTitle" class="fw-medium fs-5 mt-3">Ajouter un livre manuellement</div>
            <div class="mt-2" id="bookForm">
                {{ form_errors(form) }}
                {{ form_start(form) }}
                
                {{ form_row(form.itemType)}}
                {{ form_row(form.property_1)}}
                {{ form_row(form.property_2)}}
                {{ form_row(form.property_3)}}
                {{ form_row(form.property_4)}}
                {{ form_row(form.property_5)}}

                <div class="row ">
                    <div class="col d-flex justify-content-end">
                        {{ form_row(form.submitAndAdd) }}
                        <div class="ms-2">
                            {{ form_row(form.submit) }}
                        </div>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>



<!-- Modal SCAN -->
<div class="modal" id="barcodeScannerModal" tabindex="-1" aria-labelledby="barcodeScannerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="barcodeScannerModalLabel">Visez le code-barre du livre</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        {# reader part for scaning #}
        <div id="reader" width="600px" height="600px">
        </div>
        {# result found part #}
        <div id="scanResultContainer" class="">
        </div>
        {# no result found #}
        <div id="scanNoResultContainer">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
      </div>
    </div>
  </div>
</div>

{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'itemAdd']) }}
    {% endblock %}
{% endblock %}