{% extends 'base_auth.html.twig' %}

{% block title %}Ajout au Placard{% endblock %}

{% block body %}

{% set title = 'Ajouter au placard' %}
{% if itemCategory.code == 'bricolage' %}
    {% set title %}
        Ajouter au rayon <span class="text-highlight">bricolage</span>
    {% endset %}
{% elseif itemCategory.code == 'cuisine' %}
    {% set title %}
        Ajouter au rayon <span class="text-highlight">cuisine</span>
    {% endset %}
{% elseif itemCategory.code == 'loisirs' %}
    {% set title %}
        Ajouter au rayon <span class="text-highlight">loisirs</span>
    {% endset %}
{% elseif itemCategory.code == 'jardinage' %}
    {% set title %}
        Ajouter au rayon <span class="text-highlight">jardin</span>
    {% endset %}
{% elseif itemCategory.code == 'appareils' %}
    {% set title %}
        Ajouter un <span class="text-highlight">appareil</span>
    {% endset %}
{% endif %}

<div class="container">
    <div class="col-md-8 offset-md-2 px-2 py-3 p-lg-5">
        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}
        <div class="align-items-center d-flex flex-row justify-content-between">
            <h1 class="fw-bold fs-3" id="title">
                {% if updateMode|default(false) %}
                    Mettre à jour
                {% else %}
                    {{title}}
                {% endif %}
            </h1>
        </div>
        {# message d'alerte sur le côté global d'un objet dispo dans tous les cercles #}
        <div class="alert alert-warning  d-none" role="alert">
            <div class="d-flex justify-content-start">
                <span class="me-3"><i class="bi bi-info-circle"></i></span>
                <span>Veuillez noter que par défaut, si vous avez rejoint plusieurs boîtes, <strong>tous les éléments</strong> de votre placard seront partagés dans <strong>toutes vos boîtes</strong>.</span>
            </div>
        </div>
        {{ form_errors(form) }}
        {{ form_start(form) }}
            {{ form_row(form.itemType)}}
            {{ form_row(form.property_1)}}
            {{ form_row(form.property_2)}}
            {{ form_row(form.imageFile)}}
                <div id="imageCoverContainer" class="">
                    <a href="#" id="openFileInputBtn" class="btn btn-dark"><i class="bi bi-camera-fill me-2"></i>Ajouter une photo</a>
                    <div class="d-flex flex-column align-items-start mb-3">
                        <div class="col-8 col-md-4">
                            <img id="imgBookCover" class="img-fluid" style="display:none;"/>
                        </div>
                        <div id="retakePhotoBtn" class="mt-2" style="display:none;">
                            <a href="#" class="link-dark link-offset-2 link-opacity-75 link-underline-opacity-25 link-underline-opacity-75-hover"><i class="me-2 bi bi-arrow-counterclockwise"></i>Remplacer la photo</a>
                        </div>
                    </div>
                </div>
            <div class="row ">
                <div class="col d-flex justify-content-end">
                    {{ form_row(form.submitAndAdd) }}
                    <div class="ms-2">
                        {{ form_row(form.submit) }}
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
   
    </div>
</div>


{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'itemAddDefault']) }}
    {% endblock %}
{% endblock %}