{% extends 'base_auth.html.twig' %}

{% block title %}Mon placard{% endblock %}
{# {% set items = [] %} #}
{% block body %}
<div class="container min-vh-100">
    <div class="col-md-8 offset-md-2 px-2 py-3 p-lg-5">
        {{ include('_component/_header_title.html.twig', {
            targetLabel: "Accueil", 
            targetPath:path(name = 'app_auth_home'), 
            ctaLink: path('app_item_create'), 
            ctaLabel: "Ajouter un objet", 
            pageTitle: "Mon placard"
        })}}
        {% if items|length == 0 %}
            <div class="mt-4">
                <p class="fs-4" >Votre placard est vide. Commencez par <a class=""  href="{{path('app_item_create')}}" role="button">ajouter un objet</a>.</p>
            </div>
        {% endif %}
        {% if items|length > 0 %}
            <div class="card bg-cream border-0 p-2 mt-4">
                <div class="card-body">
                    <div class="row row-cols-1 g-4" id="items">   
                        <h6 class="text-uppercase text-secondary-emphasis mb-0">Vous proposez {{items|length}}</span> objet(s)</h6>
                        <div class="mt-4 d-lg-flex gap-lg-2">
                            <div class="input-group col">
                                <input id="filterItemsInput" class="form-control" type="text" placeholder="Rechercher un objet dans mon placard..." aria-label="input search" name="searchTerms">
                                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                            </div>
                            <div class="mt-2 mt-lg-0 col-auto">
                                <select class="form-select" id="filterItemsCategorySelect">
                                    <option selected value="">Filtrer par catégorie</option>
                                    {% for itemCategory in itemCategories %}
                                        <option value="{{itemCategory.code}}">{{itemCategory.label}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <input id="filterItemsGlobalInput" hidden type="text" name="searchTerms">
                        </div>
                        <div class="align-items-center flex-row justify-content-between mt-3 px-3" id="itemSearchResult" style="display:none;">
                            <div class="" id="itemFoundCount">
                            </div>
                            <a href="#" id="itemSearchResetFilters" class="small link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover small">
                                <i class="bi bi-x-circle me-1"></i>Réinitialiser les filtres
                            </a>
                        </div>
                        <ul class="mt-0 list">
                        {% for item in items %} 
                            <li 
                                class="list-group-item mt-3" 
                                data-item-title="{{item.property1}} {{item.property2}} {{item.itemType.label}}}}"
                                data-item-category="{{item.itemType.category.code}}"
                            >
                                <div class="col">
                                    <div class="card border-0">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between gap-3">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:64px;height:64px;flex-shrink:0;">
                                                        {% if item.imageName or item.property3 %}
                                                            <img src="{{item.imageName ? vich_uploader_asset(item, 'imageFile') : item.property3}}" alt="" class="rounded" style="width:100%;height:100%;object-fit:cover;">
                                                        {% else %}
                                                            <i class="bi {{item.itemType.category.icon}} text-secondary fs-4"></i>
                                                        {% endif %}
                                                    </div>
                                                    <div>
                                                        <p class="fw-medium mb-1">{{ item.property1 }}</p>
                                                        <p class="text-black-50 small mb-0">
                                                            {{(item.itemType.category.label ~ ' > ' ~ item.itemType.label)}}
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="btn-group">
                                                    <a href="#" class="link-dark link-offset-2 link-offset-2-hover link-underline-opacity-10 link-underline-opacity-50-hover" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        {# Plus #}
                                                        <i class="bi bi-three-dots-vertical"></i>
                                                    </a>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li  class="">
                                                            <a 
                                                                tabindex="0" 
                                                                class="dropdown-item small" 
                                                                href="{{path('app_item_update', {id: item.id})}}"
                                                            >
                                                                <i class="bi bi-pen me-2"></i>Éditer
                                                            </a>
                                                            
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li  class="">
                                                            <a 
                                                                tabindex="0" 
                                                                class="dropdown-item small text-danger" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-title="Confirmer la suppression"  
                                                                data-bs-target="#deleteObjectModal"
                                                                data-bs-item-delete-link="{{path('app_item_delete', {id: item.id})}}"
                                                                data-bs-item-title="{{item.property1}}"
                                                                href="#"
                                                            >
                                                                <i class="bi bi-trash3-fill me-2"></i>Supprimer
                                                            </a>
                                                            
                                                        </li>
                                                        
                                                        
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        {% endif %}
      </div>
    </div>
</div>
{# delete object modal #}
<div class="modal fade" id="deleteObjectModal" tabindex="-1" aria-labelledby="deleteObjectModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Supprimer un objet</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Confirmez-vous la suppression de <b>"<span class="item-title"></span>"</b> ?</br>
                <b class="text-danger">Cette action est irréversible.</b>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <a class="btn btn-primary item-delete-link" href="" class="btn btn-danger">Confirmer</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'itemIndex']) }}
    {% endblock %}
{% endblock %}