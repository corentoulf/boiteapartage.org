{% extends 'base_auth.html.twig' %}

{% block title %}Recherche • Boîte à Partage{% endblock %}

{% block body %}
<div class="container min-vh-100">
    <div class="px-lg-6">
      <div class="container-fluid" >
        {% if items|length > 0 %}
            <div class="d-flex flex-row justify-content-center mt-4 px-lg-5" style="">
                <div class="card card-bg-img-pizza-roll col-12 m-sm-4 p-2">
                <div class="card-body text-center px-4">
                    <div class="card-title fs-5 fw-bold " >
                        Prêt.e à emprunter un objet ?
                    </div>
                    <a class="btn btn-primary mt-2 mt-md-4" href="#"><i class="bi bi-journal-text me-2"></i>Consulter notre guide</span></a>
                </div>
                </div>
            </div>
        </div>
        {% endif %}
        {% if items|length == 0 %}
            <div class="mt-4 text-center">
                {% if searchTerms is defined %}
                    <div class="py-3">
                        <p class="display-2 fw-light" >{{searchTerms}}</p>
                        <p class="fs-4" >Nous n'avons rien trouvé de tel... Essayez peut-être la recherche par catégorie ?</p>
                    </div>
                    <div class="mt-4">
                        {% include '_component/category_explorer.html.twig' %}
                    </div>
                {% endif %}
                {% if categoryCode is defined %}
                    <div class="py-3">
                        <p class="fs-4" >Il n'y a pas encore d'objet dans cette catégorie...</p>
                        <p class="fs-4" >Essayez peut-être une autre ?</p>
                    </div>
                    <div class="mt-4">
                        {% include '_component/category_explorer.html.twig' %}
                    </div>
                {% endif %}
                
            </div>
        {% endif %}
        {% if items|length > 0 %}
            <div class="row my-4 px-lg-6">
                <div class="col-12">
                    <div class="row">
                        <div class="input-group col-md-6">
                            <input id="filterItemsInput" class="form-control" type="text" placeholder="Filtrer les résultats" aria-label="input search" name="searchTerms">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                        </div>
                        <div class="col-md-4 mt-2 mt-md-0">
                            <select class="form-select" id="filterItemsCategorySelect">
                                <option selected  value="">Filtrer par catégorie</option>
                                {% for itemCategory in itemCategories %}
                                    <option value="{{itemCategory.code}}">{{itemCategory.label}}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <input id="filterItemsGlobalInput" hidden type="text" name="searchTerms">
                    </div>
                </div>
            </div>
            <div class="row my-4 px-lg-6">
                <div id="items" class="col-12 col-md-9">
                    <span class="opacity-75"><span id="itemFoundCount">{{items|length}}</span> objet(s)</span>
                    <ul class="list-group list-group-flush mt-3 list">
                        {% set defaultImgUrl= asset('img/no-cover-picture-alt.svg') %}
                        {% for item in items %} 
                            {% set allowClickOnItem = true %}
                            {% set cardHighlightedWithShadow = false %}
                            {{ include('_component/item_list.html.twig') }}
                        {% endfor %}
                    </ul>
                    <ul class="pagination"></ul>
                </div>
            </div>
        {% endif %}
      </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'itemSearch']) }}
    {% endblock %}
{% endblock %}