{% extends 'base_auth.html.twig' %}

{% block title %}Recherche • Boîte à Partage{% endblock %}

{% block body %}
<div class="container min-vh-100">
    <div class="px-lg-6">
      <div class="container-fluid" >
        <div class="d-flex flex-row justify-content-center mt-4 px-lg-5" style="">
            <div class="card card-bg-img-pizza-roll col-12 m-sm-4 p-2">
            <div class="card-body text-center px-4">
                <div class="card-title fs-5 fw-bold " >
                    Vous savez comment ça marche ?
                </div>
                <a class="btn btn-primary mt-2 mt-md-4" href="#"><i class="bi bi-journal-text me-2"></i>Consulter notre guide</span></a>
            </div>
            </div>
        </div>
        {% if items|length == 0 %}
            <div class="mt-4">
                <p class="fs-4" >Hmm... Il semblerait que personne n'ait ajouté d'objets dans vos boîtes. Revenez plus tard !</p>
            </div>
        {% endif %}
        {% if items|length > 0 %}
            <div class="row my-4 px-lg-6">
                <div class="input-group col-md-8">
                    <input id="filterItemsInput" class="form-control" type="text" placeholder="Rechercher dans vos objets" aria-label="input search" name="searchTerms">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                </div>
                <div class="col-md-4 mt-2 mt-md-0">
                    <select class="form-select" id="filterItemsCategorySelect">
                        <option selected value="">Filtrer par catégorie</option>
                        {% for itemCategory in itemCategories %}
                            <option value="{{itemCategory.code}}">{{itemCategory.label}}</option>
                        {% endfor %}
                    </select>
                </div>
                <input id="filterItemsGlobalInput" hidden type="text" name="searchTerms">
            </div>
            <div class="row my-4 px-lg-6">
                <div id="items">
                    <span class="opacity-75"><span id="itemFoundCount">{{items|length}}</span> objet(s)</span>
                    <ul class="list-group list-group-flush mt-3 list">
                        {% set defaultImgUrl= asset('img/no-cover-picture-alt.svg') %}
                        {% for item in items %} 
                            <li 
                                class="list-group-item border-0 rounded p-0 mb-3" 
                                data-item-title="{{item.property1}} {{item.property2}} {{item.itemType.label}}}}"
                                data-item-category="{{item.itemType.category.code}}"
                            >
                                <div class="card d-flex flex-row border-dark-subtle" style="max-width: 700px;">
                                    {# Vignette #}
                                    <div class="col-4 col-md-3 border-right">
                                        {% if item.itemType.category.code == "bibliotheque" %}
                                            {% if item.property3 != null %}
                                                <img 
                                                    class="img-fluid rounded-start-1 object-fit-cover img-card-item" 
                                                    src="{{item.imageName ? vich_uploader_asset(item, 'imageFile') : item.property3}}"  
                                                    alt="..."
                                                >    
                                            {% else %}
                                                <img 
                                                    class="img-fluid rounded-start-1 object-fit-cover img-card-item" 
                                                    src="{{item.imageName ? vich_uploader_asset(item, 'imageFile') : defaultImgUrl}}"  
                                                    alt="..." 
                                                >    
                                            {% endif %}
                                        {% else %}
                                            <img 
                                                class="img-fluid rounded-start-1 object-fit-cover img-card-item" 
                                                src="{{item.imageName ? vich_uploader_asset(item, 'imageFile') : defaultImgUrl}}"  
                                                alt="..." 
                                            >
                                        {% endif %}
                                    </div>
                                    {# contenu #}
                                    <div class="col-8 col-md-9 d-flex flex-column justify-content-between">
                                        {# CONTENT #}
                                        <div class="d-flex flex-column h-100 justify-content-between px-3 pt-3 pb-2">
                                            {# Titre #}
                                            {% set cardTitle = item.property1 %}
                                            {% set cardSubtitle = (item.itemType.category.label == "Bibliothèque") ? ' - ' ~ item.property2 : '' %}
                                            <div class="d-flex flex-row justify-content-between align-items-top">
                                                <div class="fs-6 text-max-2-lines" title="{{cardTitle}} - {{cardSubtitle}}">
                                                    <span class="fw-bold">{{cardTitle}}</span>{{cardSubtitle}}
                                                </div>
                                                <div>
                                                    {% if item in userFavoriteItems|map(i => i.itemId) %}
                                                        <a href="#" data-item-id="{{item.id}}" class="btn-unbookmark-item link link-highlight link-underline-opacity-0 link-offset-2 link-underline-hover-75 p-0 m-0 position-relative z-3">
                                                            <i class="bi bi-star-fill fs-5"></i>
                                                        </a>
                                                    {% else %}
                                                        <a href="#" data-item-id="{{item.id}}" class="btn-bookmark-item link link-dark link-underline-opacity-0 link-offset-2 link-underline-hover-75 p-0 m-0 position-relative z-3">
                                                            <i class="bi bi-star fs-5"></i>
                                                        </a>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            {# Catégorie #}
                                            <div class="opacity-75 text-max-1-lines" >
                                                <small>{{(item.itemType.category.label ~ ' > ' ~ item.itemType.label)}}</small>
                                            </div>
                                        </div>
                                        
                                        {# ACTIONS #}
                                        {# boutons d'action #}
                                        <div class="d-none justify-content-end align-items-center border-top p-2 text-sm">
                                            <a href="{{path('app_item_update', {id: item.id})}}" class="btn btn-sm btn-outline-dark border-0 d-none d-md-block" >
                                                <i class="bi bi-pause-circle me-1"></i>
                                                Mettre en pause
                                            </a>
                                            <a href="{{path('app_item_update', {id: item.id})}}" class="btn btn-sm btn-outline-dark border-0" >
                                                <i class="bi bi-pen me-1"></i>
                                                Éditer
                                            </a>
                                            {# more actions #}
                                            <div class="btn-group ms-2">
                                                <a href="#" class="link-dark link-offset-2 link-offset-2-hover link-underline-opacity-10 link-underline-opacity-50-hover" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    {# Plus #}
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </a>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li  class="">
                                                        <a 
                                                            tabindex="0" 
                                                            class="dropdown-item small" 
                                                            href="#"
                                                        >
                                                            <i class="bi bi-pause-circle me-2"></i>Mettre en pause
                                                        </a>
                                                        
                                                    </li>
                                                    <li  class="">
                                                        <a 
                                                            tabindex="0" 
                                                            class="dropdown-item small" 
                                                            href="path('app_item_update', {id: item.id})}}"
                                                        >
                                                            <i class="bi bi-pen me-2"></i>Éditer
                                                        </a>
                                                        
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li  class="">
                                                        <a 
                                                            tabindex="0" 
                                                            class="dropdown-item small text-danger" 
                                                            data-bs-toggle="modal" 
                                                            data-bs-title="Confirmer la suppression"  
                                                            data-bs-target="#deleteObjectModal"
                                                            data-bs-item-delete-link="{{path('app_item_delete', {id: item.id})}}"
                                                            data-bs-item-title="{{cardTitle}}"
                                                            href="#"
                                                        >
                                                            <i class="bi bi-trash3-fill me-2"></i>
                                                            Supprimer
                                                        </a>
                                                        
                                                    </li>
                                                    
                                                    
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    {# modal trigger #}
                                    <a href="#" class="stretched-link"></a>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                    <ul class="pagination"></ul>
                </div>
            </div>
        {% endif %}
      </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'itemSearch']) }}
    {% endblock %}
{% endblock %}