{% extends 'base_auth.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container min-vh-100">
  <div class="col-md-8 offset-md-2 px-2 py-3 p-lg-5">
    <div class="card bg-cream border-0 p-2 mt-4">
        <div class="card-body">
          <h1 class="fs-4">Bonjour {{app.user.firstName}} 👋</h1>
          {# Rechercher un objet #}
          <form class="d-flex mt-4" role="search" aria-label="search" id="homeSearchForm" method="GET" action="{{path('app_items_search')}}">
              <div class="input-group">
                  <input class="form-control" type="text" style="" placeholder="Rechercher un objet dans mes boîtes..." aria-label="input search" id="searchTermsInput" name="q" value="{{app.request.get('q')}}">
                  <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
              </div>
          </form>
          {# CTA LAPTOP : Ajout au placard ; TODO: custom depending on what we want the user to do (eg : create a circle or join one#}
          <div class="mt-4 d-none d-md-block">
            <div class="card col-12 border-0">
              <div class="card-body">
                <div class="d-flex flex-row align-items-center justify-content-between gap-2">
                  <div class="badge text-bg-secondary p-2 fs-3">
                    <i class="bi bi-box"></i>
                  </div>
                  <div class="d-flex flex-column justify-content-center align-items-start small">
                    <div class="fw-bold " >
                      Partagez un objet dans vos boîtes 
                    </div>
                    <div>
                      Plus vous ajoutez d'objets, plus l'échange est riche
                    </div>
                  </div>
                  <div class="ms-auto">
                    <a class="btn btn-sm btn-outline-primary" href="{{path('app_item_create')}}">Ajouter un objet</span></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {# CTA MOBILE : Ajout au placard ; TODO: custom depending on what we want the user to do (eg : create a circle or join one#}
          <div class="mt-4 d-block d-md-none">
            <div class="card col-12 border-0">
              <div class="card-body">
                <div class=" d-flex flex-row align-items-center">
                  <div class="badge text-bg-secondary p-2 fs-3">
                    <i class="bi bi-box"></i>
                  </div>
                  <div class="fw-bold ms-2" >
                    Partagez un objet dans vos boîtes 
                  </div>
                </div>
                <div class="d-grid mt-2">
                  <a class="btn btn-outline-primary" href="{{path('app_item_create')}}"><i class="bi bi-plus me-1"></i>Ajouter un objet</span></a>
                </div>
              </div>
            </div>
          </div>
          {#  explorateur catégorie #}
          <div class="mt-4">
            <h6 class="text-uppercase text-secondary-emphasis mb-3">Explorer par catégorie</h6>
            {% include '_component/category_explorer_icon.html.twig' %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}{% block javascripts %}
{% block importmap %}
	{{ importmap(['app','shareCircle','generateFlyer']) }}
{% endblock %}{% endblock %}
