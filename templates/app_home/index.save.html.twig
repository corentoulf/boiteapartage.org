{% extends 'base_auth.html.twig' %}

{% block title %}Accueil
{% endblock %}

{% block body %}

<div class="container min-vh-100">
  <div class="container">
      {# New user part #}
      <div class="px-lg-6 mt-4">
        {% if userCircles|length > 0 %}
          {% if not is_granted('browse', userCircles[0].circle) %}
            <div class="alert alert-warning">
              Pour chercher un objet dans une boîte vous devez :</br>
              <ul>
                {% if app.user.isVerified != true %}
                  <li>
                    Valider votre email (si vous n'avez pas reçu le mail, <a href="{{path('app_resend_verification_email')}}">cliquez ici</a>)
                  </li>
                {% endif %}
                <li>
                  Ajouter au moins
                  <strong>5 objets</strong>
                  dans
                  <a class="link-offset-1" href="{{path('app_items_mine')}}">votre placard</a>
                </li>
              </ul>
            </div>
          {% endif %}
        {% else %}
        {# User doesn't belong to a circle yet => Invite to create or join one #}
        <div class="alert alert-warning">
          Pour chercher un objet dans une boîte vous devez :</br>
          <ul>
            {% if app.user.isVerified != true %}
              <li>
                Valider votre email
              </li>
            {% endif %}
            <li>
              <a class="link-offset-1" href="{{path('app_circle_create')}}">Créer une boîte</a>
              ou en
              <a class="link-offset-1" href="{{path('app_circle_join')}}">
                Rejoindre une</a>
            </li>
            {% if userItems|length < 5 %}
            <li>
              Ajouter au moins
              <strong>5 objets</strong>
              dans
              <a class="link-offset-1"href="{{path('app_item_create')}}">votre placard</a>
            </li>
            {% endif %}
          </ul>
        </div>
        {% endif %}
      </div>
      {# CTA : Ajout au placard #}
      <div class="d-flex flex-row justify-content-center mt-4 px-lg-5" style="">
        <div class="card card-bg-img-pizza-roll col-12 m-sm-4 p-2">
          <div class="card-body text-center">
            <div class="card-title fs-3 fw-bold " >
              C'est le moment de partager
            </div>
            <a class="btn btn-primary btn-lg mt-3" href="{{path('app_item_create')}}"><i class="bi bi-plus-square me-2"></i>Proposer un objet</span></a>
          </div>
        </div>
      </div>
      {# Inspiration part #}
      <div class="py-4 py-lg-3 px-lg-6 mt-2">
        <div class="d-flex align-items-center justify-content-between">
          <h1 class="display-5 fw-bold">Explorer</h1>
        </div>
        <div class="mt-3">
          <div class="row row-cols-2 row-cols-md-3 g-3 g-md-4">
            <div class="col">
                <div class="card card-btn-primary h-100 card-btn-bibliotheque text-light">
                    <div class="card-body justify-content-center align-items-center d-flex flex-column py-4 py-md-5">
                        <h5 class="card-title d-none"><i class="bi bi-book fs-1"></i></h5>
                        <p class="card-text fw-semibold fs-5 mb-0 mb-md-3 ">Bibliothèque</p>
                        <span class="fw-light d-none d-md-block text-center">Livres, magazines, BD</span>
                        <a href="#" class="stretched-link"></a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card card-btn-primary h-100 card-btn-loisirs text-light">
                    <div class="card-body justify-content-center align-items-center d-flex flex-column py-4 py-md-5">
                        <h5 class="card-title d-none"><i class="bi bi-dice-5 fs-1"></i></h5>
                        <p class="card-text fw-semibold fs-5 mb-0 mb-md-3">Loisirs</p>
                        <span class="fw-light d-none d-md-block text-center">Jeux de société, musique, couture</span>
                        <a href="#" class="stretched-link"></a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card card-btn-primary h-100 card-btn-appareil text-light">
                    <div class="card-body justify-content-center align-items-center d-flex flex-column py-4 py-md-5">
                        <h5 class="card-title d-none"><i class="bi bi-align-top fs-1"></i></h5>
                        <p class="card-text fw-semibold fs-5 mb-0 mb-md-3">Maison</p>
                        <span class="fw-light d-none d-md-block text-center">Électro-ménager</span>
                        <a href="#" class="stretched-link"></a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card card-btn-primary h-100 card-btn-cuisine text-light">
                    <div class="card-body justify-content-center align-items-center d-flex flex-column py-4 py-md-5">
                        <h5 class="card-title d-none"><i class="bi bi-cake fs-1"></i></h5>
                        <p class="card-text fw-semibold fs-5 mb-0 mb-md-3">Cuisine</p>
                        <span class="fw-light d-none d-md-block text-center">Robots, pâtisserie, appareils de cuisson</span>
                        <a href="#" class="stretched-link"></a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card card-btn-primary h-100 card-btn-bricolage text-light">
                    <div class="card-body justify-content-center align-items-center d-flex flex-column py-4 py-md-5">
                        <h5 class="card-title d-none"><i class="bi bi-tools fs-1"></i></h5>
                        <p class="card-text fw-semibold fs-5 mb-0 mb-md-3">Bricolage</p>
                        <span class="fw-light d-none d-md-block text-center">Outils, matériel électroportatifs</span>
                        <a href="#" class="stretched-link"></a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card card-btn-primary h-100 card-btn-jardinage text-light">
                    <div class="card-body justify-content-center align-items-center d-flex flex-column py-4 py-md-5">
                        <h5 class="card-title d-none"><i class="bi bi-flower1 fs-1"></i></h5>
                        <p class="card-text fw-semibold fs-5 mb-0 mb-md-3">Jardinage</p>
                        <span class="fw-light d-none d-md-block text-center">Outils, matériel électroportatifs</span>
                        <a href="#" class="stretched-link"></a>
                    </div>
                </div>
            </div>
          </div>
        </div>

          {# Circles part #}
          <div class="col-12 col-lg-6 pt-5 d-none">
            <div class="px-lg-6">
              <h1 class="fs-3 fw-bold mb-3">Vos Boîtes</h1>
              {{ include('app_circle/circle_list_component.html.twig') }}
              <div class="mt-3 ms-1 ms-lg-4">
                <a href="{{path('app_circle_create')}}" class="link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" type="button">
                  <i class="bi bi-plus-square me-2"></i>Créer une boîte</a>
                <a href="{{path('app_circle_join')}}" class="ms-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" type="button">
                  <i class="bi bi-box-arrow-in-up-right me-2"></i>Rejoindre une boîte</a>
              </div>
            </div>
          </div>
          {# Object part #}
          <div class="col-12 col-lg-6 py-5 d-none">
            <div class="px-lg-6">
              <h1 class="fs-3 fw-bold mb-3">Votre Placard</h1>
              
              <div class="p-2">
                {% if userItems|length < 5 %}
                  <div class="alert alert-warning">
                    Ajoutez au moins <b>5 objets</b> pour interagir avec vos boîtes à partage.
                  </div>
                {% endif %}
                {% if userItems|length > 0 %}
                  <div class="mb-2">Derniers objets ajoutés :</div>
                {% endif %}
                {% include 'app_item/item_list_component.html.twig' with {'limit': 5} %}
                <div class="mt-3 ms-1 ms-lg-4">
                  <a class="link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{path('app_item_create')}}" ><i class="bi bi-plus-square me-2"></i>Ajouter des objets</a>
                  {# <a class="ms-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{path('app_item_create_book')}}" ><i class="bi bi-plus-square me-2"></i>Ajouter des livres</a> #}
                  {% if userItems|length > 0 %}
                    <a class="ms-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" href="{{path('app_items_mine')}}"><i class="bi bi-eye me-2"></i>Voir tout</a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
</div>

{% endblock %}{% block javascripts %}
{% block importmap %}
	{{ importmap(['app','shareCircle','generateFlyer']) }}
{% endblock %}{% endblock %}
