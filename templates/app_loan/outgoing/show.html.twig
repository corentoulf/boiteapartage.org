{% extends 'base_auth.html.twig' %}

{% block title %}Suivi de la demande{% endblock %}

{% block body %}
<div class="container min-vh-100">
  <div class="col-md-8 offset-md-2 px-2 py-3 p-lg-5">
      {% for flash_error in app.flashes('verify_email_error') %}
          <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
      {% endfor %}
    <a href="#" class="text-secondary text-decoration-none small mb-3 d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Mes prêts
    </a>
    <div class="card">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h5 mb-0">Demande d'emprunt</h1>
                {{ include('app_loan/_status_badge.html.twig', {status: loan.status}) }}
            </div>

            {# Objet concerné #}
            {% set item = loan.item %}
            <div class="d-flex gap-3 pb-3 mb-3 border-bottom">
                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:64px;height:64px;flex-shrink:0;">
                    {% if item.imageName or item.property3 %}
                        <img src="{{item.imageName ? vich_uploader_asset(item, 'imageFile') : item.property3 ?? defaultImgUrl}}" alt="" class="rounded" style="width:100%;height:100%;object-fit:cover;">
                    {% else %}
                        <i class="bi bi-box-seam text-secondary fs-4"></i>
                    {% endif %}
                </div>
                <div>
                    <p class="fw-medium mb-1">{{ loan.item.property1 }}</p>
                    <p class="text-secondary small mb-0">
                        <i class="bi bi-person"></i> Demandé(e) par {{ loan.borrower.firstName }}
                    </p>
                </div>
            </div>

            {# Détails de la demande #}
            <p class="text-secondary small fw-medium mt-3 mb-2">Détails de la demande</p>
            <div class="row g-2 mb-3">
                <div class="col-4">
                    <div class="bg-light rounded p-2">
                        <p class="text-secondary mb-1" style="font-size:11px;">Demande envoyée le</p>
                        <p class="fw-medium mb-0 small">{{ loan.createdAt|date('d/m/Y') }}</p>
                    </div>
                </div>
                <div class="col-4">
                    <div class="bg-light rounded p-2">
                        <p class="text-secondary mb-1" style="font-size:11px;">Début souhaité le</p>
                        <p class="fw-medium mb-0 small">{{ loan.requestedStartDate|date('d/m/Y') }}</p>
                    </div>
                </div>
                <div class="col-4">
                    <div class="bg-light rounded p-2">
                        <p class="text-secondary mb-1" style="font-size:11px;">Retour souhaité le</p>
                        <p class="fw-medium mb-0 small">{{ loan.requestedEndDate|date('d/m/Y') }}</p>
                    </div>
                </div>
            </div>

            {# Message envoyé #}
            {% if loan.requestMessage %}
                <p class="text-secondary small fw-medium mb-2">Message du demandeur</p>
                <div class="bg-light rounded p-3 mb-3 small">
                    {{ loan.requestMessage|sanitize_html }}
                </div>
            {% endif %}

            {# Message de réponse du prêteur, si refus/acceptation #}
            {% if loan.responseMessage %}
                <p class="text-secondary small fw-medium mb-2">Réponse du propriétaire</p>
                <div class="bg-light rounded p-3 mb-3 small">
                    {{ loan.responseMessage|sanitize_html }}
                </div>
            {% endif %}

            {# Historique / timeline #}
            <p class="text-secondary small fw-medium mb-2">Historique</p>
            <ul class="list-unstyled mb-3">
                <li class="d-flex gap-2">
                    <div class="d-flex flex-column">
                        <i class="bi bi-circle-fill mb-0 pb-0 text-body-tertiary"></i>
                        <div class="border-1 border-black border-left m-0 ms-2 p-0" style="height: stretch;"></div>
                    </div>
                    <div class="mb-2">
                        <p class="mb-0 small fw-medium">Demande envoyée</p>
                        <p class="text-secondary mb-0 small">{{ loan.createdAt|date('d/m/Y à H:i') }}</p>
                    </div>
                </li>
                {% if loan.status == 'requested' %}
                    <li class="d-flex gap-2">
                        <i class="bi bi-circle text-body-tertiary" ></i>
                        <p class="mb-0 small text-secondary">En attente de votre réponse</p>
                    </li>
                {% elseif loan.status == 'accepted' %}
                    <li class="d-flex gap-2">
                        <i class="bi bi-check-circle-fill text-success" ></i>
                        <div class="mb-2">
                            <p class="mb-0 small fw-medium">Demande acceptée</p>
                            <p class="text-secondary mb-0 small">{{ loan.acceptedAt|date('d/m/Y à H:i') }}</p>
                        </div>
                    </li>
                {% elseif loan.status == 'rejected' %}
                    <li class="d-flex gap-2">
                        <i class="bi bi-x-circle-fill text-danger" ></i>
                        <div class="mb-2">
                            <p class="mb-0 small fw-medium">Demande refusée</p>
                            <p class="text-secondary mb-0 small">{{ loan.rejectedAt|date('d/m/Y à H:i') }}</p>
                        </div>
                    </li>
                {% elseif loan.status == 'cancelled' %}
                    <li class="d-flex gap-2">
                        <i class="bi bi-x-circle-fill text-secondary" ></i>
                        <div class="mb-2">
                            <p class="mb-0 small fw-medium">Demande annulée par le demandeur</p>
                            <p class="text-secondary mb-0 small">{{ loan.cancelledAt|date('d/m/Y à H:i') }}</p>
                        </div>
                    </li>
                {% endif %}
            </ul>
            {# Action d'accepter/refuser, avec un message #}
            {% if is_granted('accept_or_reject', loan) %}
            <div class="row">
                <div class="col-12 col-md-6">
                    <form method="post" action="{{ path('app_reject_outgoing_loan', {id: loan.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('reject_loan_' ~ loan.id) }}">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-x-circle"></i> Refuser la demande
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-12 col-md-6">
                    <form method="post" action="{{ path('app_accept_outgoing_loan', {id: loan.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('accept_loan_' ~ loan.id) }}">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Accepter la demande
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
  </div>
</div>

{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'itemIndex']) }}
    {% endblock %}
{% endblock %}