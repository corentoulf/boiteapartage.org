{% extends 'base_auth.html.twig' %}

{% block title %}Mes emprunts{% endblock %}

{% block body %}
<div class="container min-vh-100">
  <div class="col-md-8 offset-md-2 px-2 py-3 p-lg-5">
    {{ include('_component/_header_title.html.twig', {targetLabel: "Accueil", targetPath:path(name = 'app_auth_home'), pageTitle:"Mes emprunts"}) }}
    <div class="card bg-cream border-0 p-2 mt-4">
        <div class="card-body">
            <h6 class="text-uppercase text-secondary-emphasis">En attente de réponse du propriétaire</h6>
            {% if loansGrouped.requested|default(null) %}
                {% for loan in loansGrouped.requested %}
                    <div class="card card-clickable mt-3">
                        <div class="card-body p-3">
                            {# Objet concerné #}
                            {% set item = loan.item %}
                            {{ include('app_loan/_item_in_list.html.twig', {view:'borrower'}) }}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <span class="text-body-secondary">Aucune demande en attente de réponse.</span>
            {% endif %}
            <h6 class="text-uppercase text-secondary-emphasis mt-5">En attente de remise</h6>
            {% if loansGrouped.accepted|default(null) %}
                {% for loan in loansGrouped.accepted %}
                    <div class="card card-clickable mt-3">
                        <div class="card-body p-3">
                            {# Objet concerné #}
                            {% set item = loan.item %}
                            {{ include('app_loan/_item_in_list.html.twig', {view:'borrower'}) }}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <span class="text-body-secondary">Aucun emprunt en attente de remise.</span>
            {% endif %}
            <h6 class="text-uppercase text-secondary-emphasis mt-5">En cours</h6>
            {% if loansGrouped.ongoing|default(null) %}
                {% for loan in loansGrouped.ongoing %}
                    <div class="card card-clickable mt-3">
                        <div class="card-body p-3">
                            {# Objet concerné #}
                            {% set item = loan.item %}
                            {{ include('app_loan/_item_in_list.html.twig', {view:'borrower'}) }}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <span class="text-body-secondary">Aucun emprunt en cours.</span>
            {% endif %}
            {# Historique #}
            <div class="mt-5 d-flex justify-content-end">
                <a href="#" class="link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover small d-inline-flex align-items-center gap-1">Voir l'historique<i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
  </div>
</div>

{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'itemIndex']) }}
    {% endblock %}
{% endblock %}