{# templates/loan/_item_in_list.html.twig #}

<div class="d-flex align-items-center gap-3">
    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:64px;height:64px;flex-shrink:0;">
        {% if item.imageName or item.property3 %}
            <img src="{{item.imageName ? vich_uploader_asset(item, 'imageFile') : item.property3 ?? defaultImgUrl}}" alt="" class="rounded" style="width:100%;height:100%;object-fit:cover;">
        {% else %}
            <i class="bi bi-box-seam text-secondary fs-4"></i>
        {% endif %}
    </div>
    <div>
        <p class="fw-medium mb-1">{{ loan.item.property1 }}</p>
        <p class="text-black-50 small mb-0">
            Prêté(e) par {{ loan.borrower.shortName }}
        </p>
    </div>
    <div class="ms-auto">
        {{ include('app_loan/_status_badge.html.twig', {status: loan.status}) }}
    </div>
    <div class="px-2">
        <a href="{{ path('app_show_incoming_loan', parameters = {id: loan.id}) }}" class="stretched-link"><i class="bi bi-chevron-right"></i></a>
    </div>
</div>