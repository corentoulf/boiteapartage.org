{# templates/loan/_status_badge.html.twig #}

{% set config = {
    requested:   {label: 'En attente',  class: 'bg-warning-subtle text-warning-emphasis'},
    accepted:  {label: 'Disponibilité confirmée',    class: 'bg-success '},
    rejected:   {label: 'Refusée',     class: 'bg-danger-subtle text-danger-emphasis'},
    ongoing: {label: 'En cours',     class: 'text-bg-secondary'},
    cancelled: {label: 'Annulée',     class: 'bg-secondary text-secondary-emphasis'},
    returned:  {label: 'Terminée',    class: 'bg-secondary text-secondary-emphasis'},
}%}

{% set current = config[status] ?? {label: status, class: 'text-bg-secondary text-light-emphasis'} %}

<span class="badge rounded-pill fw-medium {{ current.class }}">{{ current.label }}</span>