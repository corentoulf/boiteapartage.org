{# templates/loan/_status_badge.html.twig #}

{% set config = {
    requested:   {label: 'En attente',  class: 'bg-warning-subtle text-light-emphasis'},
    accepted:  {label: 'Acceptée',    class: 'bg-success-subtle '},
    rejected:   {label: 'Refusée',     class: 'bg-danger-subtle text-light-emphasis'},
    ongoing: {label: 'En cours',     class: 'bg-secondary text-light-emphasis'},
    cancelled: {label: 'Annulée',     class: 'bg-secondary text-light-emphasis'},
    returned:  {label: 'Terminée',    class: 'bg-secondary text-light-emphasis'},
}%}

{% set current = config[status] ?? {label: status, class: 'text-bg-secondary'} %}

<span class="badge rounded-pill {{ current.class }}">{{ current.label }}</span>