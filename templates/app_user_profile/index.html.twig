{% extends 'base_auth.html.twig' %}

{% block title %}Mon Compte{% endblock %}

{% block body %}
<div class="container min-vh-100">
    <div class="px-lg-6 col-md-8 offset-md-2">
        <div class="container-fluid py-2 py-lg-4">
            <h1 class="display-5 fw-bold">Mon compte</h1>
            <div class="d-flex align-items-center justify-content-end my-3 d-none">
                <a class="btn btn-primary px-4"  href="{{path('app_logout')}}" role="button"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a>
            </div>
            {% if not app.user.isVerified %}
                <div class="row my-4">
                    <div class="col">
                        <div class="alert alert-warning">
                            <div class="d-flex flex-column justify-content-center align-items-center">
                                <div>
                                    <b>Vous n'avez pas encore validé votre email.</b></br>
                                    Merci de cliquer sur le lien reçu pour utiliser les boîtes à partage (vérifiez vos SPAMS).</br>
                                </div>
                                {% if is_granted('requestVerificationEmail') %}
                                    <div class="mt-3">
                                        <a
                                            type="button"
                                            class="btn btn-dark"
                                            href={{path('app_resend_verification_email')}}
                                        >
                                            <i class="bi bi-send me-2"></i>Renvoyer le lien de vérification
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
            <div class="row my-4">
                <div class="col">
                    <div class="row row-cols-1 row-cols-md-2 g-3 g-md-4">
                        <div class="col">
                            <div class="card card-btn-primary h-100 ">
                                <div class="card-body text-center">
                                    <h5 class="card-title "><i class="bi bi-person-fill fs-1"></i></h5>
                                    <p class="card-text fw-semibold fs-5">Informations</p>
                                    <span class="fw-light">Modifier l'email, le numéro de tél.</span>
                                    <a href="{{path('app_user_update_profile')}}" class="stretched-link"></a>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card card-btn-primary h-100 ">
                                <div class="card-body text-center">
                                    <h5 class="card-title "><i class="bi bi-gear-fill fs-1"></i></h5>
                                    <p class="card-text fw-semibold fs-5">Préférences</p>
                                    <span class="fw-light">Choisir mon mode de contact</span>
                                    <a href="{{path('app_user_update_preference')}}" class="stretched-link"></a>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card card-btn-primary h-100 ">
                                <div class="card-body text-center">
                                    <h5 class="card-title "><i class="bi bi-key fs-1"></i></h5>
                                    <p class="card-text fw-semibold fs-5">Mot de passe</p>
                                    <span class="fw-light">Modifier mon mot de passe</span>
                                    <a href="{{path('app_user_update_password')}}" class="stretched-link"></a>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card card-btn-primary h-100 ">
                                <div class="card-body text-center">
                                    <h5 class="card-title "><i class="bi bi-box-arrow-right fs-1"></i></h5>
                                    <p class="card-text fw-semibold fs-5">Déconnexion</p>
                                    <span class="fw-light">Se déconnecter du compte</span>
                                    <a href="{{path('app_logout')}}" class="stretched-link"></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class=""><hr class="mt-4 mb-2"></div>
            <div class="d-flex flex-row justify-content-center justify-content-md-end">
                <a href="{{ path('app_user_delete_account') }}" class="btn btn-outline-danger border-0 mb-3">
                    <i class="bi bi-trash me-2"></i>Supprimer mon compte
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
