{% extends 'base_auth.html.twig' %}

{% block title %}Recherche • Boîte à Partage{% endblock %}

{% block body %}
<div class="container min-vh-100">
    <div class="px-lg-6">
        <div class="container-fluid py-2 py-lg-4">
            <h1 class="display-5 fw-bold">Recherche</h1>
            {% if items|length > 0 %}
                <div class="mt-4">
                    <div class="col-12 pt-3 pb-2">
                        <input type="text" name="filtr-search" id="filterItemTableInput" focused class="form-control" placeholder="Taper pour chercher" aria-label="Rechercher un élément" aria-describedby="externalFilter" value="{{searchTerms}}">
                    </div>
                    <div class="filter-container">
                        {% for item in items %}  
                        {# <pre>
                            {{ dump(item) }}
                        </pre> #}
                            <div class="filtr-item" data-category="{{item.itemType.category.label}}" data-sort="{{item.property1}}">
                                <div class="card" style="width: 18rem;">
                                    <img src="" class="card-img-top" alt="...">
                                    <div class="card-body">
                                        <h5 class="card-title">{{item.property1}}</h5>
                                        <p class="card-text">{{item.property2}}</p>
                                        <a href="#" class="btn btn-primary">Emprûnter</a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    {# <div class="d-none">
                        <table class="table table-striped table-hover d-none" id="itemTable">
                            <thead>
                                <tr>
                                <th scope="col">Catégorie</th>
                                <th scope="col">Nom</th>
                                <th scope="col">Prop 2</th>
                                <th scope="col">Propriétaire</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in items %}  
                                    <tr>
                                        <td>{{item.typeLabel}}</td>
                                        <td>{{item.property_1}}</td>
                                        <td>{{item.property_2}}</td>
                                        <td>{{item.owner}}</td>
                                    </tr>
                                {% endfor %}
                                
                            </tbody>
                        </table>
                    </div> #}
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% endblock %}
{% block javascripts %}
    {% block importmap %}
     {{ importmap(['app', 'searchItem']) }}
    {% endblock %}
{% endblock %}