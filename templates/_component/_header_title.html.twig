{% if targetLabel|default(false) %}
    <a href="{{targetPath|default('#')}}" class="link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover small mb-3 d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i>{{targetLabel}}
    </a>
{% endif %}
<div class="d-flex flex-row justify-content-between align-items-center">
    <h1 class="ff-serif text-primary">{{pageTitle}}</h1>
    {% if ctaLink|default(false) %}
        <a href="{{ctaLink|default('#')}}" class="btn btn-primary">
            {{ctaLabel}}
        </a>
    {% endif %}
</div>