<div id="flashMessageContainer" class="container-fluid d-flex justify-content-end position-absolute ct-flash-message" style="z-index: 2000;">
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="col-12 col-md-6 col-lg-4 col-xl-3 me-0 me-md-3 mt-3 mt-md-0 alert d-flex justify-content-between alert-{{ label }} {% if label not in ['success'] %}alert-dismissable fade show{% endif %}" role="alert">
            <p class="m-0 me-2">{{ message }}</p>
            {% if label not in ['success'] %}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>{% endif %}
        </div>
    {% endfor %}
{% endfor %}
</div>
